{
  "_comment": "Only stores with a public, structured product feed. kind: 'discount' = full-bottle discounter, 'decant' = decant/sample shop, 'mixed' = sells both (small sizes count as decants only when labelled as samples). Shopify stores expose /products.json. brandFrom 'title' = the shop's vendor field is the shop itself, so the house is read from the product title. adapter 'sitemap' = product URLs from the sitemap, a rotating slice checked each day (pageFormat 'jsonld' reads schema.org data from the page; 'shopify-js' reads Shopify's per-product .js for shops that block the bulk feed).",
  "sources": [
    {
      "id": "maxaroma",
      "name": "MaxAroma",
      "kind": "discount",
      "adapter": "sitemap",
      "base": "https://www.maxaroma.com",
      "sitemap": "https://www.maxaroma.com/sitemap.xml",
      "idPattern": "/pid/(\\d+)/",
      "include": "^(fragrance/(?!.*gift-sets)|pocket-perfume/|vial/)",
      "dailyBudget": 1200,
      "maxAgeDays": 21,
      "rps": 1,
      "priority": [
        "^fragrance/(men|women)",
        "^fragrance/unisex$",
        "testers",
        "^fragrance/niche",
        "^pocket-perfume",
        "^vial"
      ],
      "pageFormat": "jsonld"
    },
